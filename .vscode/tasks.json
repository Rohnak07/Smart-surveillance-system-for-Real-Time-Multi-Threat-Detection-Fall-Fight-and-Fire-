{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Smart surveillance system for Real-Time Multi-Threat Detection (Fall, Fight, and Fire): Start Phone Camera",
      "type": "process",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": ["run_phone.py"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "focus": false,
        "panel": "dedicated",
        "showReuseMessage": false
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "runOptions": {
        "instanceLimit": 1
      }
    }
  ]
}
